import { HorizontalBox, VerticalBox, Button, Slider } from "std-widgets.slint";
import { MediaActions, SlintState, SlintTimeline } from "data-flow.slint";
import { VolumeSlider } from "components/volume-slider.slint";

export component MediaControllers {
	in property<SlintTimeline> playing;
	property<bool> dragging;

	in-out property<float> volume: 50;
	property <bool> hovering: hover_zone.has-hover;

	Timer {
		property<int> count: 0;
		interval: 1000ms;
		running: SlintState.timeline.length > 0 ? true : false;
		triggered() => {
			if !dragging && playing.current != playing.length {
				MediaActions.media_get_track_position();
			}
		}
	}

	VerticalBox {
		HorizontalBox {
			alignment: center;
			spacing: 5px;

			Button { text: @tr("mix"); clicked => { MediaActions.media_mix() } }
			Button { text: @tr("prev"); clicked => { MediaActions.media_change(-1) } }
			Button { text: @tr("start"); clicked => { MediaActions.media_toggle() } }
			Button { text: @tr("next"); clicked => { MediaActions.media_change(1) } }
			Button { text: @tr("loop"); clicked => { MediaActions.media_loop() } }
			hover_zone := TouchArea {
				width: 124px;
				height: 24px;
				// Image {
				// 	width: 24px;
				// 	height: 24px;
				// 	source: @image-url("volume-icon.svg");
				// }
				HorizontalLayout {
					spacing: 8px;

					Rectangle {
						width: 32px;
						height: 32px;
						background: Colors.pink;
					}

					volume_slider := Slider {
						// orientation: Orientation.vertical;
		      			width: hovering ? 100px : 0px;
		                opacity: hovering ? 1.0 : 0.0;
		                value <=> root.volume;
						step: 0.1;
		                animate width, opacity { duration: 150ms; }
						changed(value) => {
							MediaActions.media_change_volume(value)
						}
					}
				}
			}
		}

		VerticalBox {
			Slider {
				width: 90%;
				height: 10px;
				value: playing.current;
				minimum: 0.0;
				maximum: playing.length;
				changed(_) => {
					dragging = true;
					MediaActions.media_pause();
				}
				released(position) => {
					dragging = false;
					MediaActions.media_change_track_position(position);
					MediaActions.media_toggle();
				}
			}
			HorizontalBox {
				Text { text: playing.str_current; horizontal-alignment: left; }
				Text { text: playing.str_length; horizontal-alignment: right; }
			}
		}
	}
}
