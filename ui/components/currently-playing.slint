import { SlintTrack } from "../data-flow.slint";

export component CurrentlyPlaying {
	in property<SlintTrack> track;

	if track.playing: Text {
		font-size: 14px;
		horizontal-alignment: center;
		height: track.playing ? 20px : 0px;
		width: 100%;
		text: track.title + " - " + track.artist;
		animate height, opacity { duration: 150ms; }
	}
}
