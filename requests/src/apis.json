[
	{
		"url": "https://accounts.spotify.com/api",
		"prefix": "SPOTIFY",
		"enabled": false,
		"paths": {
			"artist": {
				"path": "/v1/artists/",
				"path_parameters": {},
				"headers": { "Content-Type": "application/x-www-form-urlencoded" },
				"body": { "Authorization": "BEARER_TOKEN" }
			},
			"auth-token": {
				"path": "/token",
				"path_parameters": {},
				"headers": { "Content-Type": "application/x-www-form-urlencoded" },
				"body": {
					"grant_type": "client_credentials",
					"client_id": "ENV.CLIENT_ID",
					"client_secret": "ENV.CLIENT_SECRET"
				}
			},
			"authenticate": {
				"path": "/authorize?",
				"path_parameters": {
					"response_type": "code",
					"client_id": "ENV.CLIENT_ID",
					"scope": "user-read-private,user-read-email",
					"redirect_uri": "ENV.REDIRECT_URI",
					"code_challenge_method": "S256",
					"code_challenge": "OPERATION.GENERATED"
				},
				"headers": { "Content-Type": "application/x-www-form-urlencoded" },
				"body": {
					"grant_type": "client_credentials",
					"client_id": "ENV.CLIENT_ID"
				}
			}
		}
	},
	{
		"url": "https://www.youtube.com/watch?v=eVTXPUF4Oz4",
		"prefix": "YOUTUBE",
		"enabled": true,
		"paths": {
			"base": {
				"path": "",
				"headers": { "Content-Type": "application/x-www-form-urlencoded" },
				"body": {},
				"path_parameters": {}
			},
			"authenticate": {
				"path": {
					"main": "https://www.googleapis.com",
					"sub": "/auth/youtube"
				},
				"path_parameters": {
					"response_type": "code",
					"client_id": "ENV.CLIENT_ID",
					"scope": "user-read-private,user-read-email",
					"redirect_uri": "ENV.REDIRECT_URI",
					"code_challenge_method": "S256",
					"code_challenge": "OPERATION.GENERATED"
				},
				"headers": { "Content-Type": "application/x-www-form-urlencoded" },
				"body": {
					"grant_type": "client_credentials",
					"client_id": "ENV.CLIENT_ID"
				}
			}
		},
		"user_playlists": {
			"path": {
