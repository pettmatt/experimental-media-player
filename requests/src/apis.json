			"path_parameters": {
				"oauth2_token": "OPERATION.AUTH"
			},
			"headers": { "Content-Type": "application/x-www-form-urlencoded" }
		},
		"search": {
			"path": {
				"main": "https://www.googleapis.com",
				"sub": "/youtube/v3/search"
			},
			"path_parameters": {
				"oauth2_token": "OPERATION.AUTH"
			},
			"headers": { "Content-Type": "application/x-www-form-urlencoded" }
		}
